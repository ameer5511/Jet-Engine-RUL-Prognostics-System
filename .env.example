# AeroGuard v2 — environment template
# Copy to .env and fill in real values. NEVER commit .env.
#
# Exact model name / endpoint / auth format must be confirmed in the Nebius
# Token Factory console (Open Question B5 in MASTER_SPEC.md). The placeholders
# below are intentionally not guessed.

# Nebius Token Factory API key
NEBIUS_API_KEY=

# Base URL of the Token Factory OpenAI-compatible endpoint (confirm in console)
TOKEN_FACTORY_BASE_URL=

# NVIDIA Nemotron (free hosted endpoint via build.nvidia.com)
# OpenAI-compatible base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Nemotron model available on the free endpoint
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Your API key goes here — generated at build.nvidia.com. NEVER commit this file.
NVIDIA_API_KEY=

# Optional: cap live calls per run to protect credits
NEMOTRON_MAX_CALLS=5

# Nebius Token Factory (alternative OpenAI-compatible endpoint)
NEBIUS_API_KEY=

# Base URL of the Token Factory OpenAI-compatible endpoint (confirm in console)
TOKEN_FACTORY_BASE_URL=
