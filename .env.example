# Jet Engine RUL Prognostics System — environment template
# Copy to .env and fill in real values. NEVER commit .env.
#
# The pipeline calls NVIDIA's Nemotron model through the free, OpenAI-compatible
# hosted endpoint at build.nvidia.com. Only scenarios.py reads these variables.

# API key generated at build.nvidia.com
NVIDIA_API_KEY=

# OpenAI-compatible base URL for the NVIDIA hosted endpoint
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Exact Nemotron model ID as listed in the build.nvidia.com catalog
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional: cap live calls per run to protect quotas
NEMOTRON_MAX_CALLS=5

# Validated Nemotron suggestions are cached to results/nemotron_scenarios.json,
# so reruns are deterministic and cost nothing.
